{
  "info": {
    "name": "Auth - Usuario y reglas de negocio",
    "description": "Ejecutar en orden con el microservicio y PostgreSQL activos. El primer registro genera un correo de prueba; la respuesta guarda userId. Las últimas solicitudes eliminan únicamente ese usuario. Los rechazos de negocio usan HTTP 200 y success=false. Los errores de entrada usan 400. No se fuerza un error 500 en la base de datos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/ecommerce/user",
      "type": "string"
    },
    {
      "key": "testMail",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "Clave123!",
      "type": "string"
    },
    {
      "key": "updatedPassword",
      "value": "Nueva123!",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Registrar adulto",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"testMail\", \"u\" + Date.now() + \"@a.co\");",
              "pm.collectionVariables.set(\"userId\", \"\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const result = pm.response.json();",
              "pm.test(\"Resultado de la operación\", function () { pm.expect(result.success).to.eql(true); });",
              "pm.test(\"Mensaje\", function () { pm.expect(result.message).to.eql(\"Usuario registrado correctamente\"); });",
              "pm.test(\"La respuesta no expone la contraseña\", function () { if (result.user) { pm.expect(result.user).not.to.have.property(\"password\"); } });",
              "if (result.success && result.user) { pm.collectionVariables.set(\"userId\", result.user.idUser); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/save",
        "description": "Usuario registrado correctamente",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Usuario Postman\",\n  \"mail\": \"{{testMail}}\",\n  \"password\": \"{{password}}\",\n  \"rol\": \"USER\",\n  \"age\": 18,\n  \"phoneNumber\": \"3001234567\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
